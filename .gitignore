# Local settings, environments and Python/Jupyter caches.
.codex/
.agents/
.env
.env.*
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.ipynb
!/mei_corpus_checks.ipynb
!/mei_facsimile_viewer.ipynb

# Shared per-score editorial CSVs are tracked; full execution artifacts stay local.
/validation/runs/
/validation/viewer-backups/
/validation/notebook-backups/
/validation/cleanup-backups/
/validation/report-backups/

# Keep the public command-line tools explicit; other local helpers are ignored.
/scripts/*
!/scripts/archive/
!/scripts/archive/update_readme_progress.py
!/scripts/validate_corpus.py
!/scripts/refresh_editorial_reports.py
!/scripts/check_mei_consistency.py
!/scripts/update_camat.py
!/scripts/sync_camat_viewer.py
!/scripts/convert_uppsala_scans.py

# Retired local development tools, notes and contributor progress data.
/docs/archive/local-tools/artifacts/
/mei_progress.py
/mei_progress_plots.py
/mei_corrected_full_checks.ipynb
/fb_startid_to_tstamp_workflow.ipynb
/progress_tracker_with_outputs_local.ipynb
/Arbeitsorga_MEI_Encoding_CAMAT.xlsx
/dokuwiki.txt
/requirements.txt
/issue_drafts/

